<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No ActionBar: the WebView owns the whole screen. windowBackground is black so the
         cold start never flashes white before the feed paints. -->
    <style name="Theme.FastVideo.Shell" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/feed_black</item>
        <item name="android:colorBackground">@color/feed_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowAnimationStyle">@style/Animation.FastVideo.Shell</item>
        <item name="android:textColorPrimary">@color/shell_text_primary</item>
        <item name="android:alertDialogTheme">@style/Theme.FastVideo.Dialog</item>
    </style>

    <style name="Animation.FastVideo.Shell" parent="android:Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@android:anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@android:anim/fade_out</item>
    </style>

    <style name="Theme.FastVideo.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/shell_accent</item>
        <item name="android:textColorPrimary">@color/shell_text_primary</item>
        <item name="android:background">@color/shell_panel</item>
    </style>

    <style name="ShellTitle">
        <item name="android:textColor">@color/shell_text_primary</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ShellBody">
        <item name="android:textColor">@color/shell_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="ShellButtonAccent" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_accent</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">22dp</item>
        <item name="android:paddingRight">22dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ShellButtonGhost" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/shell_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
