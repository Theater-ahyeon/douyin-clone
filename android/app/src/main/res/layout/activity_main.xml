<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shellRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/feed_black">

    <!-- Index 0 is filled at runtime by MainActivity.buildWebView(), so a crashed renderer can
         be discarded and replaced without re-inflating the layout. -->

    <!-- Hosts the <video> fullscreen custom view; sits above the WebView when visible. -->
    <FrameLayout
        android:id="@+id/customViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/feed_black"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/loadProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:max="100"
        android:progressDrawable="@drawable/bg_load_progress"
        android:visibility="gone" />

    <!-- Small translucent entry point for 连接设置; kept out of the page's own tap targets. -->
    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="6dp"
        android:layout_marginTop="6dp"
        android:alpha="0.34"
        android:background="@drawable/bg_settings_button"
        android:contentDescription="@string/cd_settings_button"
        android:elevation="6dp"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_settings" />

    <LinearLayout
        android:id="@+id/errorPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/feed_black"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_error_panel"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="26dp"
            android:paddingEnd="22dp"
            android:paddingBottom="22dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/cd_error_icon"
                android:src="@drawable/ic_cloud_off" />

            <TextView
                style="@style/ShellTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/error_title" />

            <TextView
                android:id="@+id/errorDetail"
                style="@style/ShellBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/error_desc"
                android:textColor="@color/shell_text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/errorSettingsButton"
                    style="@style/ShellButtonGhost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/error_settings" />

                <Button
                    android:id="@+id/errorRetryButton"
                    style="@style/ShellButtonAccent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/error_retry" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
