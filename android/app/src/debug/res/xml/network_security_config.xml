<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG ONLY (src/debug/res/xml overrides the resource of the same name in the release/main
  source set for the debug build type).

  A debug build is what developers install on a test handset, where the backend is frequently
  reachable at an arbitrary address (mDNS name, tailnet IP, IPv6 link-local...). Permit
  cleartext everywhere for that build, and additionally trust user-installed CAs so a
  proxy such as Charles/mitmproxy can inspect the feed traffic.

  Release builds get the restrictive config from src/main/res/xml/network_security_config.xml.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
